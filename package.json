{
  "name": "court-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "connect": "node scripts/connect.ts",
    "probe": "node scripts/diagnostics/mccarren.ts inspect",
    "check:format": "prettier --check .",
    "format": "prettier --write .",
    "check:types": "tsc --noEmit",
    "test": "node --test scripts/**/*.test.ts packages/**/*.test.ts apps/**/*.test.ts",
    "build": "tsc && vite build --config apps/web/vite.config.ts",
    "start": "node dist/apps/service/src/main.js",
    "dev": "node --watch apps/service/src/main.ts",
    "verify": "corepack pnpm check:format && corepack pnpm check:types && corepack pnpm test && corepack pnpm build"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "luxon": "3.7.2",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
